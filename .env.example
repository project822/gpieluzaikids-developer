# ============================================================
# Eluzai Dev Console — Konfigurasi Environment
# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.
# ============================================================

# --- Kredensial login dashboard (single user / developer) ---
# Username & password dipakai untuk login ke dashboard ini.
DASHBOARD_USERNAME=developer
DASHBOARD_PASSWORD=ganti-password-ini

# --- Secret untuk JWT sesi dashboard (WAJIB diganti) ---
# Bisa dibuat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SECRET=

# --- URL website utama (yang dikelola dashboard ini) ---
# Produksi: https://gpieluzaikids.vercel.app
# Dev lokal: http://localhost:22889 (server D:\church)
SITE_BASE_URL=https://gpieluzaikids.vercel.app

# --- URL website utama untuk sisi client (tautan & preview) ---
NEXT_PUBLIC_SITE_URL=https://gpieluzaikids.vercel.app

# --- Kunci bersama project /dev ---
# WAJIB SAMA dengan DEV_API_KEY di .env.local website utama (D:\church).
# Dipakai dashboard untuk memanggil /api/dev/* di website utama.
DEV_API_KEY=

# --- MongoDB (opsional untuk sekarang) ---
# Connection string dari MongoDB Atlas (Database > Connect > Drivers).
# Bisa dikosongkan dulu — dashboard tetap berfungsi; status koneksi bisa
# dicek via GET /api/db/health.
MONGODB_URI=
# Nama database (default: eluzai-dashboard)
MONGODB_DB=eluzai-dashboard

# --- Blokir IP (opsional) ---
# Daftar IP yang diblokir total, pisahkan koma (mis. "1.2.3.4,5.6.7.8").
# Berlaku untuk semua permintaan (halaman & API) via proxy.
BLOCKED_IPS=

# --- DNS override (opsional) ---
# Saat koneksi MongoDB gagal ECONNREFUSED di Windows (resolver c-ares
# terbaca loopback), dashboard otomatis memakai 8.8.8.8/1.1.1.1.
# Isi untuk memaksa daftar server DNS sendiri (format "8.8.8.8,1.1.1.1").
DNS_SERVERS=
